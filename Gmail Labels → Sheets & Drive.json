      "parameters": {
        "jsCode": "// Folder to upload into: resolved sender folder from the previous node.\nconst folderId = $input.first().json.id;\n// Attachments live on the loop's current email item.\nconst binary = $('Current Email').first().binary || {};\nconst results = [];\nfor (const key of Object.keys(binary)) {\n  const b = binary[key];\n  results.push({\n    json: { fileName: b.fileName || 'attachment', folderId },\n    binary: { data: b },\n  });\n}\nreturn results;"
