    {
      "parameters": {
        "jsCode": "const LABEL_NAMES = {\n  Label_1: 'Junk',\n  Label_2: 'Unwanted',\n  Label_3: '[Notion]',\n  Label_4: 'Job Alerts',\n  Label_5: 'Learning Reminders',\n  Label_6: 'Online course',\n  Label_7: 'Assessment invitation notifications',\n  Label_8: 'Application Status',\n  Label_6961433786476260004: 'Primary',\n  Label_8078516865586220558: 'Receipts',\n};\nconst SYSTEM = new Set(['INBOX', 'SENT', 'DRAFT', 'SPAM', 'TRASH', 'UNREAD', 'STARRED', 'IMPORTANT', 'CHAT', 'YELLOW_STAR']);\nconst sanitize = (s) => String(s || '').replace(/[\\/:*?\"<>|']/g, '_').replace(/\\s+/g, ' ').trim();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const addr = (j.from && j.from.value && j.from.value[0]) || {};\n  const email = String(addr.address || '').trim();\n  const name = String(addr.name || '').trim() || (email.split('@')[0] || 'Unknown');\n  const ids = Array.isArray(j.labelIds) ? j.labelIds : [];\n  const userLabelId = ids.find((id) => !SYSTEM.has(id) && !String(id).startsWith('CATEGORY_'));\n  const label = userLabelId ? (LABEL_NAMES[userLabelId] || userLabelId) : 'INBOX';\n  const dateObj = j.date ? new Date(j.date) : new Date();\n  const receivedDate = dateObj.toISOString().slice(0, 10);\n  const binary = item.binary || {};\n  const attachmentCount = Object.keys(binary).length;\n  out.push({\n    json: {\n      senderName: name,\n      senderEmail: email,\n      subject: String(j.subject || '').trim(),\n      receivedDate,\n      receivedAt: dateObj.toISOString(),\n      label,\n      gmailId: j.id,\n      messageId: String(j.messageId || '').replace(/[<>]/g, '').trim(),\n      attachmentCount,\n      labelFolder: sanitize(label),\n      dateFolder: receivedDate,\n      senderFolder: sanitize(name),\n    },\n    binary,\n  });\n}\nreturn out;"
      },
